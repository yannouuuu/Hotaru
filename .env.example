# Discord Bot Token
CLIENT_TOKEN=your_discord_bot_token_here

# Bot Owner ID
OWNER_ID=your_discord_user_id

# Bot Developer IDs (comma-separated)
DEVELOPER_IDS=your_id,another_id


# ==========================================
# 📧 Configuration SMTP (Système de vérification)
# ==========================================

# --- Gmail (Recommandé pour le développement) ---
# Pour utiliser Gmail :
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Générez un "mot de passe d'application" : https://support.google.com/accounts/answer/185833
# 3. Utilisez ce mot de passe dans SMTP_PASS (pas votre mot de passe principal)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application-16-caracteres-sans-espaces

# Expéditeur des emails (nom affiché dans les emails)
EMAIL_FROM="Hotaru Bot <noreply@hotaru-bot.com>"


# --- Alternative : Outlook/Hotmail ---
# Décommentez et modifiez pour utiliser Outlook :
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@outlook.com
# SMTP_PASS=votre-mot-de-passe


# --- Alternative : SMTP universitaire ---
# Décommentez et modifiez pour utiliser le serveur SMTP de votre université :
# SMTP_HOST=smtp.univ-lille.fr
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre-login-universitaire
# SMTP_PASS=votre-mot-de-passe-universitaire


# ==========================================
# 💼 Configuration France Travail (Flux jobs)
# ==========================================

# Identifiants API (obligatoires)
FRANCE_TRAVAIL_CLIENT_ID=votre_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=votre_client_secret

# Portée OAuth personnalisée (optionnelle)
# FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"

# Paramètres de recherche par défaut (optionnels)
# FRANCE_TRAVAIL_KEYWORDS=informatique,développeur
# FRANCE_TRAVAIL_DEPARTMENTS=59,62
# FRANCE_TRAVAIL_COMMUNES=59350,59009,59599,59343
# FRANCE_TRAVAIL_CONTRACTS=CDI,CDD,MIS,SAI
# FRANCE_TRAVAIL_EXPERIENCE=1,2
# FRANCE_TRAVAIL_LIMIT=5
# FRANCE_TRAVAIL_RADIUS_KM=5
# FRANCE_TRAVAIL_INCLUDE_ALTERNANCE=false
# FRANCE_TRAVAIL_MIN_HOURS=168            # Ignorer les offres plus anciennes que X heures
# FRANCE_TRAVAIL_UPDATE_INTERVAL=10       # Intervalle en minutes entre deux rafraîchissements automatiques


# ==========================================
# 🤖 Suite IA & Productivité
# ==========================================

# --- OpenRouter ---
OPENROUTER_API_KEY=votre_cle_api_openrouter

# (Optionnel) Personnaliser le modèle ou les métadonnées envoyées
# OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# ⚠️ Vérifiez sur https://openrouter.ai/settings/privacy que le modèle choisi est autorisé.
# ⏳ Si OpenRouter renvoie un code 429, le bot réessaie jusqu'à 3 fois (en suivant `Retry-After` si présent).
# ⌛ Si l'erreur persiste, patientez quelques secondes supplémentaires avant de relancer la commande.
# OPENROUTER_APP_URL=https://votre-site-ou-docs
# OPENROUTER_APP_TITLE="Hotaru Discord Bot"
# OPENROUTER_APP_URL=https://votre-site-ou-docs


# ==========================================
# ⏰ Rappels personnels
# ==========================================

# (Optionnel) Intervalle entre deux vérifications des rappels (en millisecondes, min 5000)
# REMINDERS_TICK_INTERVAL_MS=30000

# (Optionnel) Limite de rappels actifs par utilisateur et par serveur
# REMINDERS_MAX_PER_USER=20

